{
  "__inputs": [],
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "13.3.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-peer handshake and traffic metrics written by a wg show dump textfile script (wireguard_peer_info, wireguard_peer_latest_handshake_seconds, wireguard_peer_receive_bytes_total, wireguard_peer_transmit_bytes_total, wireguard_interface_up_since_seconds).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "alloy"
      ],
      "asDropdown": false,
      "title": "Alloy dashboards",
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Interface up for",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max(wireguard_interface_up_since_seconds{host=\"$host\", interface=\"$interface\"})",
          "legendFormat": "up",
          "format": "time_series",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "vertical",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Peers configured",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(wireguard_peer_info{host=\"$host\", interface=\"$interface\"})",
          "legendFormat": "peers",
          "format": "time_series",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "vertical",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Peers connected",
      "description": "Peers with a handshake in the last 3 minutes. Active peers re-handshake every 2 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((time() - wireguard_peer_latest_handshake_seconds{host=\"$host\", interface=\"$interface\"}) < 180 and wireguard_peer_latest_handshake_seconds{host=\"$host\", interface=\"$interface\"} > 0) or vector(0)",
          "legendFormat": "connected",
          "format": "time_series",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "vertical",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Traffic (1h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(wireguard_peer_receive_bytes_total{host=\"$host\", interface=\"$interface\"}[1h]))",
          "legendFormat": "from peers",
          "format": "time_series",
          "editorMode": "code",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(wireguard_peer_transmit_bytes_total{host=\"$host\", interface=\"$interface\"}[1h]))",
          "legendFormat": "to peers",
          "format": "time_series",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "vertical",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Peers",
      "description": "Peer names come from the peer label. Byte counters reset when the interface restarts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(time() - max by (peer) (wireguard_peer_latest_handshake_seconds{host=\"$host\", interface=\"$interface\"} > 0)) or (max by (peer) (wireguard_peer_latest_handshake_seconds{host=\"$host\", interface=\"$interface\"} == 0) - 1)",
          "legendFormat": "__auto",
          "format": "table",
          "editorMode": "code",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (peer) (wireguard_peer_receive_bytes_total{host=\"$host\", interface=\"$interface\"})",
          "legendFormat": "__auto",
          "format": "table",
          "editorMode": "code",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (peer) (wireguard_peer_transmit_bytes_total{host=\"$host\", interface=\"$interface\"})",
          "legendFormat": "__auto",
          "format": "table",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "peer": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "peer": "Peer",
              "Value #A": "Last handshake",
              "Value #B": "Received",
              "Value #C": "Sent"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Peer"
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last handshake"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-1": {
                        "text": "never",
                        "color": "text",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": 180
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Received|Sent"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Peer"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Throughput per peer",
      "description": "Peers that have completed a handshake. Above zero: traffic received from the peer. Below zero: traffic sent to the peer.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 10,
        "y": 4,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (peer) (rate(wireguard_peer_receive_bytes_total{host=\"$host\", interface=\"$interface\"}[5m])) * 8 and on (peer) max by (peer) (wireguard_peer_latest_handshake_seconds{host=\"$host\", interface=\"$interface\"} > 0)",
          "legendFormat": "{{peer}} from peer",
          "format": "time_series",
          "editorMode": "code",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (peer) (rate(wireguard_peer_transmit_bytes_total{host=\"$host\", interface=\"$interface\"}[5m])) * -8 and on (peer) max by (peer) (wireguard_peer_latest_handshake_seconds{host=\"$host\", interface=\"$interface\"} > 0)",
          "legendFormat": "{{peer}} to peer",
          "format": "time_series",
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Time since last handshake",
      "description": "Drops under 2 minutes while a peer is connected, then climbs when it goes idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max by (peer) (wireguard_peer_latest_handshake_seconds{host=\"$host\", interface=\"$interface\"} > 0)",
          "legendFormat": "{{peer}}",
          "format": "time_series",
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [
    "alloy",
    "wireguard"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "host",
        "label": "Host",
        "description": "",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(wireguard_peer_info, host)",
        "query": {
          "qryType": 1,
          "query": "label_values(wireguard_peer_info, host)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {},
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "interface",
        "label": "Interface",
        "description": "",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(wireguard_peer_info{host=\"$host\"}, interface)",
        "query": {
          "qryType": 1,
          "query": "label_values(wireguard_peer_info{host=\"$host\"}, interface)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {},
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "WireGuard peers",
  "uid": "wireguard-peers",
  "version": 1,
  "weekStart": ""
}
